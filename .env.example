# AirSense AI - Environment Configuration Template
# Copy this file to '.env' or add keys to '.streamlit/secrets.toml'
# Note: Real-world Open-Meteo & Copernicus CAMS integration functions out-of-the-box without requiring API keys.

# Optional OpenAQ API Key (for v3 CPCB Indian stations if custom access is desired)
OPENAQ_API_KEY=your_openaq_api_key_here

# Optional WAQI (World Air Quality Index) Token (if custom station feed is desired)
WAQI_API_TOKEN=your_waqi_api_token_here

# Application Configuration
AIRSENSE_DEFAULT_CITY=Pune
AIRSENSE_DEFAULT_STATION=karve_nagar
AIRSENSE_REFRESH_INTERVAL_HOURS=6
AIRSENSE_DB_PATH=airsense.db
